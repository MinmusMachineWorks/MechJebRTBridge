<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>MechJebRTBridge</RootNamespace>
    <AssemblyName>MechJebRTBridge</AssemblyName>
    <LangVersion>8</LangVersion>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Prefer32Bit>false</Prefer32Bit>
    <!-- Release tags are v-prefixed (v0.1.0); MinVer ignores them without this. -->
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <!-- The in-game test harness is its own project; keep its sources out of this DLL. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);tests/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <!-- MinVer sets $(Version) / $(FileVersion) from git tags (v0.1.0 → 0.1.0) -->
    <PackageReference Include="MinVer" Version="4.*" PrivateAssets="All" />
    <PackageReference Include="KSPBuildTools" Version="1.1.1" />
  </ItemGroup>

  <!-- Hard dependencies — the bridge is useless without both mods installed.
       CKANIdentifier drives `ckan install` in CI via setup-ckan + install-dependencies.
       Locally, set KSPBT_InstallCKANDependencies=false (see Directory.Build.props.user). -->
  <ItemGroup>
    <ModReference Include="MechJeb2">
      <DLLPath>GameData/MechJeb2/Plugins/MechJeb2.dll</DLLPath>
      <CKANIdentifier>MechJeb2</CKANIdentifier>
    </ModReference>
    <ModReference Include="RemoteTech">
      <DLLPath>GameData/RemoteTech/Plugins/RemoteTech.dll</DLLPath>
      <CKANIdentifier>RemoteTech</CKANIdentifier>
    </ModReference>
    <ModReference Include="0Harmony">
      <DLLPath>GameData/000_Harmony/0Harmony.dll</DLLPath>
      <CKANIdentifier>Harmony2</CKANIdentifier>
    </ModReference>
  </ItemGroup>

  <!-- .version file generated on build. VERSION is deliberately not set here: KSPBuildTools
       fills it from $(FileVersion) inside its target, after MinVer has computed it. Setting it
       from $(MinVer*) properties here would evaluate them before MinVer runs (empty → "..").
       Destination is gitignored; it ends up in GameData/ for packaging. -->
  <ItemGroup>
    <KSPVersionFile Include=".">
      <Destination>$(KSPBT_ModRoot)MechJebRTBridge.version</Destination>
      <URL>https://github.com/MinmusMachineWorks/MechJebRTBridge/releases/latest/download/MechJebRTBridge.version</URL>
      <Download>https://github.com/MinmusMachineWorks/MechJebRTBridge/releases/latest</Download>
      <KSP_Version>1.12</KSP_Version>
      <KSP_Version_Min>1.8</KSP_Version_Min>
      <KSP_Version_Max>1.12</KSP_Version_Max>
    </KSPVersionFile>
  </ItemGroup>

</Project>
